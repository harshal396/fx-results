+"""Harshal's rule families (used by agents/my_books.py). Candles are mid prices, index = candle START (New York clock),
+columns open/high/low/close. Every value on candle i uses only candles up to and including i.
+
+  ema_rsi    BUY  close > EMA21, RSI(14) crosses UP through 55 on this candle, close higher than the candle before
+             SELL close < EMA21, RSI(14) crosses DOWN through 44, close lower than the candle before
+  rsi_mtf    BUY  the higher-timeframe RSIs are all above 60 and the entry-timeframe RSI crosses up through 60
+             SELL the higher-timeframe RSIs are all below 40 and the entry-timeframe RSI crosses down through 40
+             higher timeframes: 15m -> 1h and 4h | 1h -> 4h and 1D | 4h -> 1D
+  ema_cross  BUY  EMA9 crosses above EMA21 and the candle closes above EMA21
+             SELL EMA9 crosses below EMA21 and the candle closes below EMA21
+
+Gates applied by the books (in this order, each one is journalled when it stops a signal):
+  Supertrend(10, 3) on the same timeframe: buy only while it is up, sell only while it is down
+  chop: Choppiness Index CHOP(14) >= 61.8 (fxagents/regime.py) -> no entry
+Stop: lowest low / highest high of the last 8 candles -/+ 0.25 ATR(14).
+
+4h and 1D candles are built from completed hourly candles on the New York wall clock, as on OANDA: 4h candles start
+01/05/09/13/17/21, the trading day runs 17:00 -> 17:00. A higher-timeframe RSI is used only once its candle has closed.
+"""
+from __future__ import annotations
+
+import numpy as np
+import pandas as pd
+
+from .indicators import atr, ema, rsi
+from .regime import chop_index
+
+NY = "America/New_York"
+HTF = {"15min": ("1h", "4h"), "1h": ("4h", "1D"), "4h": ("1D",), "1D": ()}      # RSI 60/40 higher timeframes
+WARMUP = {"15min": 100, "1h": 100, "4h": 60, "1D": 30}                            # candles before a signal counts
+ST_PERIOD, ST_MULT = 10, 3.0                                                      # TradingView's Supertrend defaults
+R = dict(ema=21, fast=9, rsi=14, up=55, dn=44, hi=60, lo=40, stop_lb=8, stop_buf=0.25)
+
+
+def supertrend(h: np.ndarray, l: np.ndarray, c: np.ndarray, period: int = ST_PERIOD, mult: float = ST_MULT) -> np.ndarray:
+    """Supertrend direction per candle: +1 uptrend (price above the line), -1 downtrend, 0 before it is defined.
+    Standard recursion: bands = hl2 -/+ mult*ATR(RMA); a band only tightens unless the previous close broke through it."""
+    n = len(c)
+    pc = np.r_[np.nan, c[:-1]]
+    tr = np.nanmax(np.vstack([h - l, np.abs(h - pc), np.abs(l - pc)]), axis=0)
+    a = np.full(n, np.nan)
+    if n >= period:
+        a[period - 1] = tr[:period].mean()                                        # RMA seeded with the first SMA
+        for i in range(period, n):
+            a[i] = (a[i - 1] * (period - 1) + tr[i]) / period
+    hl2 = (h + l) / 2
+    ub, lb = hl2 + mult * a, hl2 - mult * a
+    fub, flb, d = ub.copy(), lb.copy(), np.zeros(n, dtype=int)
+    for i in range(period - 1, n):
+        if i == period - 1:
+            d[i] = 1 if c[i] >= hl2[i] else -1
+            continue
+        fub[i] = ub[i] if (ub[i] < fub[i - 1] or c[i - 1] > fub[i - 1]) else fub[i - 1]
+        flb[i] = lb[i] if (lb[i] > flb[i - 1] or c[i - 1] < flb[i - 1]) else flb[i - 1]
+        if d[i - 1] == 1:
+            d[i] = -1 if c[i] < flb[i] else 1
+        else:
+            d[i] = 1 if c[i] > fub[i] else -1
+    return d
+
+
+def _labels(h1: pd.DataFrame, tf: str):
+    loc = h1.index.tz_localize(None) if h1.index.tz is not None else h1.index          # New York wall clock
+    if tf == "4h":
+        bs = ((loc.hour - 1) // 4) * 4 + 1                                              # 00:00 belongs to the 21:00 candle
+        return loc.normalize() + pd.to_timedelta(bs, unit="h"), pd.Timedelta("4h")
+    if tf == "1D":
+        return (loc + pd.Timedelta(hours=7)).normalize() - pd.Timedelta(hours=7), pd.Timedelta("24h")   # 17:00 -> 17:00
+    raise ValueError(tf)
+
+
+def build_tf(h1: pd.DataFrame, tf: str):
+    """4h / 1D candles from hourly candles. Returns (candles indexed by start, naive wall-clock END of each candle)."""
+    lab, dur = _labels(h1, tf)
+    g = h1[["open", "high", "low", "close"]].groupby(lab)
+    df = pd.DataFrame({"open": g["open"].first(), "high": g["high"].max(), "low": g["low"].min(), "close": g["close"].last()})
+    end = df.index + dur
+    df.index = df.index.tz_localize(NY, ambiguous=np.ones(len(df), dtype=bool), nonexistent="shift_forward")
+    return df, end
+
+
+def htf_rsi_vec(h1: pd.DataFrame, rule: str, when: pd.DatetimeIndex) -> np.ndarray:
+    """RSI(14) of the last FULLY CLOSED 1h / 4h / 1D candle at each decision time in `when`."""
+    w = (when.tz_convert(NY) if when.tz is not None else when).tz_localize(None)
+    if rule == "1h":
+        loc = h1.index.tz_localize(None) if h1.index.tz is not None else h1.index
+        c, end = pd.Series(h1["close"].to_numpy(), index=loc), loc + pd.Timedelta("1h")
+    else:
+        lab, dur = _labels(h1, rule)
+        c = pd.Series(h1["close"].to_numpy(), index=lab).groupby(level=0).last()
+        end = c.index + dur
+    r = rsi(c, R["rsi"]).to_numpy()
+    i = end.searchsorted(w, side="right") - 1
+    return np.where(i >= 0, r[np.clip(i, 0, None)], np.nan)
+
+
+def build(df: pd.DataFrame, h1: pd.DataFrame, rule: str, tf: str) -> pd.DataFrame:
+    """Indicators and the raw signal (+1 buy / -1 sell / 0) for every candle of `df` (columns open/high/low/close)."""
+    d = df[["open", "high", "low", "close"]]
+    c = d["close"]
+    E21, E9, Rs, A = ema(c, R["ema"]), ema(c, R["fast"]), rsi(c, R["rsi"]), atr(d, 14)
+    C, H, L = c.to_numpy(), d["high"].to_numpy(), d["low"].to_numpy()
+    n = len(d)
+    pc, pr = np.r_[np.nan, C[:-1]], np.r_[np.nan, Rs.to_numpy()[:-1]]
+    e21, e9, rs = E21.to_numpy(), E9.to_numpy(), Rs.to_numpy()
+    pe21, pe9 = np.r_[np.nan, e21[:-1]], np.r_[np.nan, e9[:-1]]
+    extra = {}
+    with np.errstate(invalid="ignore"):
+        if rule == "ema_rsi":
+            up = (C > e21) & (pr <= R["up"]) & (rs > R["up"]) & (C > pc)
+            dn = (C < e21) & (pr >= R["dn"]) & (rs < R["dn"]) & (C < pc)
+        elif rule == "ema_cross":
+            up = (pe9 <= pe21) & (e9 > e21) & (C > e21)
+            dn = (pe9 >= pe21) & (e9 < e21) & (C < e21)
+        elif rule == "rsi_mtf":
+            when = d.index + pd.Timedelta("24h" if tf == "1D" else tf)
+            hs = [htf_rsi_vec(h1, r, when) for r in HTF[tf]]
+            for k, v in enumerate(hs):
+                extra[f"htf{k + 1}"] = v
+            hi_ok = np.all([v > R["hi"] for v in hs], axis=0) if hs else np.zeros(n, bool)
+            lo_ok = np.all([v < R["lo"] for v in hs], axis=0) if hs else np.zeros(n, bool)
+            up = hi_ok & (pr <= R["hi"]) & (rs > R["hi"])
+            dn = lo_ok & (pr >= R["lo"]) & (rs < R["lo"])
+        else:
+            raise ValueError(rule)
+    raw = np.where(up, 1, np.where(dn, -1, 0))
+    raw[np.arange(n) < WARMUP[tf]] = 0
+    lo_ = pd.Series(L).rolling(R["stop_lb"], min_periods=1).min().to_numpy()
+    hi_ = pd.Series(H).rolling(R["stop_lb"], min_periods=1).max().to_numpy()
+    a = A.to_numpy()
+    out = pd.DataFrame({"o": d["open"], "h": d["high"], "l": d["low"], "c": c, "ema21": E21, "ema9": E9, "rsi": Rs,
+                        "atr": A, "chop": chop_index(d), "st": supertrend(H, L, C), "raw": raw,
+                        "stop_long": lo_ - R["stop_buf"] * a, "stop_short": hi_ + R["stop_buf"] * a}, index=d.index)
+    for k, v in extra.items():
+        out[k] = v
+    return out
